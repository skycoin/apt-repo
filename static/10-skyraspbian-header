#!/bin/bash
#
# Skyraspbian MOTD header — Raspberry Pi boards only. On other boards the
# companion 10-skybian-header renders the banner, so this one exits early.
#
# DO NOT run a live `apt-get update` here: this script executes on EVERY SSH
# login, and refreshing the apt lists over the network added ~8-65s to each
# login (worse on slow eMMC or when a repo is slow) — the cause of the
# "ssh is slow after installing Skywire" reports. The daily apt-daily.timer
# keeps the lists fresh; here we only report the already-cached count.
THIS_SCRIPT="skyraspbian-header"
MOTD_DISABLE=""
[[ -f /etc/default/armbian-motd ]] && . /etc/default/armbian-motd
for f in $MOTD_DISABLE; do
	[[ $f == $THIS_SCRIPT ]] && exit 0
done

# Only render on actual Raspberry Pi hardware; every other board (Armbian
# OrangePi, x86, etc.) is handled by 10-skybian-header. This also avoids the
# raspbian-only tools below (vcgencmd/raspi-config) running where they don't
# exist.
grep -qi raspberry /proc/device-tree/model 2>/dev/null || exit 0

. /etc/os-release

let upSeconds="$(/usr/bin/cut -d. -f1 /proc/uptime)"
let secs=$((${upSeconds}%60))
let mins=$((${upSeconds}/60%60))
let hours=$((${upSeconds}/3600%24))
let days=$((${upSeconds}/86400))
UPTIME=`printf "%d days, %02dh%02dm%02ds" "$days" "$hours" "$mins" "$secs"`
KERNELID=$(uname -r)
if command -v vcgencmd >/dev/null 2>&1; then
	CPUTemp=$(vcgencmd measure_temp | awk {'print substr($1,6,10)'})
else
	CPUTemp="n/a"
fi
IP=$(hostname -I | awk {'print $1'})
# Cached upgradable-package count only — NO network refresh (see header note).
# `timeout` is a hard ceiling so login can never stall; the simulate needs no
# root, so there's no sudo prompt or lock wait either.
UPDATES=$(timeout 5 apt-get -s upgrade 2>/dev/null | grep -cE "^Inst")
MY_OUT=$(echo -e "[ \e[0;32m$UPDATES updates to install:\x1B[0m \e[0;31msudo apt-get upgrade\x1B[0m ]")
CONFIG=$(echo -e "[ \e[0;32mGeneral system configuration:\x1B[0m \e[0;31msudo raspi-config\x1B[0m ]")

# get the load averages
read one five fifteen rest < /proc/loadavg

toilet -f standard -F metal "     Skybian"

echo -e "Welcome to Skybian, the Official miner OS for Skycoin on the $(cat /proc/device-tree/model | tr -d '\0')"
echo -e "Based on \e[0;91mRaspbian \x1B[0m$(if [[ $ID == raspbian ]]; then echo ${PRETTY_NAME^} |  sed -e 's/^.*Linux //' | sed "s/\/.*//"; else echo -n ${VERSION_CODENAME^};fi) with \e[0;91mLinux $KERNELID\x1B[0m\n"

echo "$(tput setaf 2)
`date +"%A, %e %B %Y, %r"`
`uname -srmo`
$(tput sgr0)

Uptime:         `echo -e "\e[0;32m$UPTIME\x1B[0m"`
Load Averages:  `echo -e "\e[0;32m$one, $five, $fifteen (1, 5, 15 min)\x1B[0m"`
Memory usage:   `cat /proc/meminfo | grep MemFree | awk {'print $2'}`kB (Free) / `cat /proc/meminfo | grep MemTotal | awk {'print $2'}`kB (Total)
CPU temp:       `echo -e "\e[0;32m$CPUTemp\x1B[0m"`
Usage of /:     `echo -e "\e[0;32m$(df -h | awk 'NR==2{print $5}')\x1B[0m of $(df -h | awk 'NR==2{print $2}')"`
IP:             `echo -e "\e[0;32m$IP\x1B[0m"`

$MY_OUT

$CONFIG
"
