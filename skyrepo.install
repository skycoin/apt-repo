# pacman install scriptlet for the Arch skyrepo package.
# Imports + locally-signs the Skycoin packaging key and appends the signed
# [skywire] repo to /etc/pacman.conf. Idempotent; $arch is kept LITERAL so
# pacman expands it per-machine. Mirrors skyrepo.deb's postinst (apt source + key).

_KEYFP=48F19E5157BE6014D80A47328D6D51BC4AD7AE64
_KEYFILE=/usr/share/skyrepo/skywire-pacman.gpg
_MIRROR=https://deb.theskywirenetwork.net

_skyrepo_configure() {
	# Import the packaging key into pacman's own keyring and locally sign it so
	# SigLevel = Required is satisfied without prompting. The key is SHIPPED in
	# this package (/usr/share/skyrepo/skywire-pacman.gpg), so this never needs
	# to fetch from a keyserver — the same reason skyrepo.deb ships the key to
	# /etc/apt/trusted.gpg.d/.
	pacman-key --init >/dev/null 2>&1 || true
	if [ -f "$_KEYFILE" ]; then
		pacman-key --add "$_KEYFILE" >/dev/null 2>&1 || true
		pacman-key --lsign-key "$_KEYFP" >/dev/null 2>&1 || true
	fi
	# Add the [skywire] repo once. $arch stays literal (single-quoted) — pacman
	# substitutes the machine's architecture at sync time.
	if ! grep -q '^\[skywire\]' /etc/pacman.conf 2>/dev/null; then
		printf '\n[skywire]\nSigLevel = Required\nServer = %s/archlinux/$arch\n' "$_MIRROR" >> /etc/pacman.conf
	fi
	# Config for skyrepo-upgrade.service: only the [skywire] block from pacman.conf,
	# so the timer syncs and upgrades our packages and never core/extra.
	mkdir -p /etc/skyrepo
	{
		printf '# Generated by skyrepo from /etc/pacman.conf. Used by skyrepo-upgrade.service.\n[options]\nArchitecture = auto\n\n'
		awk '/^\[/{s=($0=="[skywire]")} s' /etc/pacman.conf
	} > /etc/skyrepo/pacman-skywire.conf
	cat <<'EOM'
==> skyrepo: the signed [skywire] pacman repo is configured.
    Install:  pacman -Syu skywire-bin
    Auto-upgrade to each new release:  systemctl enable --now skyrepo-upgrade.timer
EOM
}

post_install() {
	_skyrepo_configure
}

post_upgrade() {
	_skyrepo_configure
}

pre_remove() {
	systemctl disable --now skyrepo-upgrade.timer >/dev/null 2>&1 || true
	rm -f /etc/skyrepo/pacman-skywire.conf
	rmdir /etc/skyrepo 2>/dev/null || true
	# Remove the [skywire] block we appended (header through its Server line).
	if grep -q '^\[skywire\]' /etc/pacman.conf 2>/dev/null; then
		sed -i '/^\[skywire\]/,/^Server *=.*\/archlinux\//d' /etc/pacman.conf 2>/dev/null || true
	fi
}
